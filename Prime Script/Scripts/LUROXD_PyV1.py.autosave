def distance(p1, p2):
    return ((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2 + (p1[2] - p2[2])**2)**0.5

# Semaphores / Flags
SpeechInterrupt = False
ObjectRec = True
SpeechActive = False
ESPConnected = False
sensor_hmirror=False
sensor_vflip=False
kpu_task = None
kpu_ready = False

